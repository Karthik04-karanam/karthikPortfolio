# ==============================================================================
# KARTHIK PORTFOLIO BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` in the `backend/` folder and customize for your environment.
# Never commit your actual `.env` file containing secret passwords or credentials.

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Karthik Portfolio API"
ENVIRONMENT=development
DEBUG=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: persistent SQLite database in backend directory.
# For PostgreSQL in production, change to:
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db
DATABASE_URL=sqlite:///./portfolio.db

# ------------------------------------------------------------------------------
# 3. CORS ALLOWED ORIGINS (Comma-separated)
# ------------------------------------------------------------------------------
# Include your local web server port (e.g. 5500 for Live Server, 3000 for React/Vite)
# In production, replace with your actual live portfolio domain (e.g. https://yourdomain.com)
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# If left empty, contact messages will still be saved securely in the SQLite database,
# but email notifications will be skipped safely without crashing the application.
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your_gmail@gmail.com
#   SMTP_PASSWORD=your_16_character_app_password
#   SENDER_EMAIL=your_gmail@gmail.com
#   RECIPIENT_EMAIL=karanamvenkatjaykarthik@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
SENDER_EMAIL=
RECIPIENT_EMAIL=karanamvenkatjaykarthik@gmail.com

# ------------------------------------------------------------------------------
# 5. SECURITY & ABUSE PREVENTION
# ------------------------------------------------------------------------------
# Maximum allowed submissions per client IP within the sliding time window
RATE_LIMIT_MAX_REQUESTS=5
# Sliding window in seconds (600 = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600
# Maximum request body size in bytes (65536 = 64 KB)
MAX_REQUEST_SIZE_BYTES=65536
